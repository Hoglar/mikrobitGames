{
  "openapi": "3.1.0",
  "info": {
    "title": "Fasit fra kontrakt 1.5",
    "version": "1.3"
  },
  "paths": {
    "/v1/answer": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "request_id",
                  "player_id",
                  "conversation_id",
                  "player_name",
                  "question"
                ],
                "properties": {
                  "request_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "player_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "game_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uuid"
                  },
                  "conversation_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "player_name": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 32,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Svar",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "request_id",
                    "status",
                    "answer"
                  ],
                  "properties": {
                    "request_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "no_data",
                        "cannot_answer"
                      ]
                    },
                    "answer": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "notices": {
                      "type": "array",
                      "maxItems": 21,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Feil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "request_id",
                    "error"
                  ],
                  "properties": {
                    "request_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "uuid"
                    },
                    "error": {
                      "type": "string",
                      "const": "INVALID_REQUEST"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Feil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "request_id",
                    "error"
                  ],
                  "properties": {
                    "request_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "uuid"
                    },
                    "error": {
                      "type": "string",
                      "const": "AI_BUSY"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Feil",
