        <mxCell id="internet" source="browser" target="network" value="HTTPS" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;defaultLabelBackgroundColor=page;">
          <mxGeometry as="geometry" relative="1" />
