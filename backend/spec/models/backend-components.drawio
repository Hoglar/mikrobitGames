        <mxCell id="backenddb" source="backend" target="postgres" value="backend_app" edge="1" parent="home" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;defaultLabelBackgroundColor=page;">
          <mxGeometry as="geometry" relative="1" />
