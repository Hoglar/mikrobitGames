          <mxGeometry as="geometry" x="400" y="60" width="220" height="80" />
        </mxCell>
        <mxCell id="webfiles" value="&lt;b&gt;Webappens bygde filer&lt;/b&gt;&lt;br&gt;Samme HTTPS-adresse" vertex="1" parent="home" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#f5f5f5;strokeColor=#666666;">
