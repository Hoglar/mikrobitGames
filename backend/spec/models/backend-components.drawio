          <mxGeometry as="geometry" x="400" y="240" width="220" height="80" />
        </mxCell>
        <mxCell id="postgres" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;127.0.0.1:5432" vertex="1" parent="home" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=cylinder3;size=12;fillColor=#d5e8d4;strokeColor=#82b366;">
          <mxGeometry as="geometry" x="400" y="420" width="220" height="80" />
        </mxCell>
        <mxCell id="ai" value="&lt;b&gt;AI-tjeneste&lt;/b&gt;&lt;br&gt;Lokal port, foreslått 8001" vertex="1" parent="home" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;">
          <mxGeometry as="geometry" x="760" y="240" width="220" height="80" />
        </mxCell>
        <mxCell id="ollama" value="&lt;b&gt;Ollama + Qwen&lt;/b&gt;&lt;br&gt;127.0.0.1:11434" vertex="1" parent="home" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#f5f5f5;strokeColor=#666666;">
          <mxGeometry as="geometry" x="760" y="420" width="220" height="80" />
        </mxCell>
        <mxCell id="boot" value="&lt;b&gt;systemd:&lt;/b&gt; automatisk oppstart, kontrollert prosessrestart og logger.&lt;br&gt;Vedvarende data og konfigurasjon. AI er ikke nødvendig for vanlig spill/rekordlagring." vertex="1" parent="home" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;text;fillColor=none;strokeColor=none;align=left;fontSize=14;">
