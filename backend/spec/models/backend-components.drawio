        </mxCell>
        <mxCell id="home" value="&lt;b&gt;Linux-PC hjemme&lt;/b&gt; · Parrot Linux · 16 GB RAM · lokal PostgreSQL og AI" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlane;startSize=40;fillColor=#f5f8fc;swimlaneFillColor=#ffffff;strokeColor=#6c8ebf;rounded=0;fontSize=15;">
