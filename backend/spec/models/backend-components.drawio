        <mxCell id="legend" value="Piler viser kall/avhengigheter; svar følger samme vei tilbake. Stiplet pil gjelder bare readiness-kontroll.&lt;br&gt;Spilleridentitet kommer fra sesjonen. Skriving kontrollerer sesjonen på nytt i transaksjonen.&lt;br&gt;Forsøk leses bare av eieren; AI ser offentlige rekorder.&lt;br&gt;Ingen DB-lås eller forbindelse holdes mens AI arbeider." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;text;fillColor=none;strokeColor=none;align=left;fontSize=13;">
          <mxGeometry as="geometry" x="40" y="740" width="1080" height="70" />
        </mxCell>
      </root>
