        <mxCell id="backendai" source="backend" target="ai" value="Lokal HTTP" edge="1" parent="home" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;defaultLabelBackgroundColor=page;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="aimodel" source="ai" target="ollama" value="Modellkall" edge="1" parent="home" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;defaultLabelBackgroundColor=page;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="aidb" source="ai" target="postgres" value="ai_reader" edge="1" parent="home" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;defaultLabelBackgroundColor=page;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="limits" value="Bare HTTPS-inngangen publiseres. Interne tjenester og Caddys administrasjon er ikke offentlige.&lt;br&gt;CGNAT, DNS og ruterregler må kontrolleres før publisering. PC/nett av = tjenesten nede.&lt;br&gt;Plan B: offentlig HTTPS-tunnel (Tailscale Funnel / Cloudflare Tunnel).&lt;br&gt;Testmål: vanlig funksjon tilbake innen 5 minutter etter at OS og nettverk er klare." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;text;fillColor=none;strokeColor=none;align=left;fontSize=14;">
          <mxGeometry as="geometry" x="40" y="960" width="1140" height="90" />
        </mxCell>
