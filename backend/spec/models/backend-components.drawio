          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="static" source="caddy" target="webfiles" value="Nettside" edge="1" parent="home" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;defaultLabelBackgroundColor=page;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="proxy" source="caddy" target="backend" value="/api/*" edge="1" parent="home" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;defaultLabelBackgroundColor=page;">
          <mxGeometry as="geometry" relative="1" />
