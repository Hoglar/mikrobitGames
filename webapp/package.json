{
  "name": "microbit-games-webapp",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "firmware:update": "node verification/update-firmware.mjs",
    "game:new": "node verification/game-tools.mjs new",
    "game:check": "node verification/game-tools.mjs check",
    "game:pack": "node verification/game-tools.mjs pack",
    "pretest": "npm run build",
    "test": "node --test --test-timeout=10000 tests/unit/*.test.js tests/microbit-input/*.test.js",
    "test:input": "node --test --test-timeout=10000 tests/microbit-input/*.test.js",
    "test:browser": "playwright test",
    "dev:input": "node verification/serve-input.js",
    "benchmark": "node verification/benchmark.js",
    "benchmark:input": "node verification/benchmark-input.js",
    "dev": "node verification/serve-app.js",
    "build": "node verification/build.js",
    "preview": "node verification/serve-app.js --dist",
    "catalog:commands": "node verification/catalog-commands.mjs",
    "test:app": "playwright test --config playwright.app.config.js",
    "test:cartridges": "playwright test --config playwright.cartridges.config.js",
    "pretest:cartridges": "npm run build",
    "pretest:app": "npm run build"
  },
  "devDependencies": {
    "@microbit-games/sdk": "file:src/game-sdk",
    "@playwright/test": "1.64.1",
    "acorn": "8.15.0",
    "ajv": "8.20.0",
    "esbuild": "0.25.12"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
