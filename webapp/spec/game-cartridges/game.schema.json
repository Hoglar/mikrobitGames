{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Micro:bit Games cartridge manifest v1 (proposed)",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "sdkVersion", "id", "slug", "version", "title", "description", "author", "license", "entry", "cover", "controls", "viewport", "modes"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "sdkVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/uuid" },
    "slug": { "$ref": "#/$defs/key" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "maxLength": 32 },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "author": { "type": "string", "minLength": 1, "maxLength": 80 },
    "license": { "type": "string", "minLength": 1, "maxLength": 120 },
    "entry": { "const": "index.js" },
    "cover": { "enum": ["cover.png", "cover.webp"] },
    "styles": { "const": "style.css" },
    "controls": { "type": "string", "minLength": 1, "maxLength": 300 },
    "genre": { "type": "string", "minLength": 1, "maxLength": 32 },
    "accent": { "enum": ["green", "purple", "yellow", "pink", "blue"] },
    "order": { "type": "integer", "minimum": 0, "maximum": 9999 },
    "defaultMode": { "$ref": "#/$defs/key" },
    "viewport": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height", "minWidth", "minHeight", "fit"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "minWidth": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "minHeight": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "fit": { "enum": ["contain", "responsive"] }
      }
    },
    "selectors": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/selector" } },
    "modes": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/mode" } }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "safeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "selector": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "label", "options"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "options": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["value", "label"],
            "properties": { "value": { "$ref": "#/$defs/key" }, "label": { "type": "string", "minLength": 1, "maxLength": 80 } }
          }
        }
      }
    },
    "mode": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "rulesVersion", "config", "score"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "rulesVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "legacyGameId": { "$ref": "#/$defs/uuid" },
        "legacyScoreUnit": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
        "summary": { "type": "string", "maxLength": 300 },
        "config": { "type": "object", "maxProperties": 64 },
        "selection": { "type": "object", "propertyNames": { "$ref": "#/$defs/key" }, "additionalProperties": { "$ref": "#/$defs/key" }, "maxProperties": 8 },
        "score": {
          "type": "object", "additionalProperties": false, "required": ["fields"],
          "properties": {
            "offset": { "$ref": "#/$defs/safeInteger" },
            "fields": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/scoreField" } }
          }
        }
      }
    },
    "scoreField": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "label", "min", "max", "direction", "format"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$", "maxLength": 32 },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "min": { "$ref": "#/$defs/safeInteger" },
        "max": { "$ref": "#/$defs/safeInteger" },
        "direction": { "enum": ["higher_is_better", "lower_is_better"] },
        "format": { "enum": ["integer", "duration-ms"] },
        "unit": { "type": "string", "minLength": 1, "maxLength": 32 },
        "radix": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    }
  }
}
