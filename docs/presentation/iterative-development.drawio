          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e6" value="Ny runde?" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=12;strokeWidth=3;strokeColor=#64748b;fontSize=15;defaultLabelBackgroundColor=page;" edge="1" source="decision" target="order" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Blå:&lt;/b&gt; du / gruppen     &lt;b&gt;Lilla:&lt;/b&gt; utviklings-AI     &lt;b&gt;Grønn:&lt;/b&gt; kontrollverktøy" style="whiteSpace=wrap;html=1;fontSize=18;spacing=12;text;fillColor=none;strokeColor=none;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="150" y="890" width="900" height="40" />
        </mxCell>
        <mxCell id="baseline" value="Første komplette måling = baseline. Minst tre målepunkter over tid; også regresjoner beholdes." style="whiteSpace=wrap;html=1;fontSize=18;spacing=12;text;fillColor=none;strokeColor=none;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="940" width="1040" height="35" />
        </mxCell>
        <mxCell id="note" value="Full kjøring inkluderer virkelig lokal AI. Faste regler vurderer resultatene, uten AI som dommer.&lt;br&gt;Endrer vi modell eller kontrollgrunnlag, starter vi en ny måleserie eller måler tidligere versjoner om." style="whiteSpace=wrap;html=1;fontSize=18;spacing=12;text;fillColor=none;strokeColor=none;fontSize=14;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="980" width="1040" height="55" />
