<mxfile host="app.diagrams.net">
  <diagram id="iteration" name="Iterasjonssirkelen">
    <mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="1050" arrows="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Vår iterative utvikling&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=18;spacing=12;text;fillColor=none;strokeColor=none;fontSize=30;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="120" y="20" width="960" height="55" />
        </mxCell>
        <mxCell id="subtitle" value="Database + backend API + lokal AI" style="whiteSpace=wrap;html=1;fontSize=18;spacing=12;text;fillColor=none;strokeColor=none;fontSize=18;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="200" y="80" width="800" height="35" />
        </mxCell>
        <mxCell id="foundation" value="&lt;b&gt;Før vi starter&lt;/b&gt;&lt;br&gt;Avtal modeller, testfasit&lt;br&gt;og faste kontroller." style="whiteSpace=wrap;html=1;fontSize=18;spacing=12;rounded=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="120" width="240" height="100" />
        </mxCell>
        <mxCell id="center" value="&lt;b&gt;Du styrer&lt;br&gt;hver runde&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ingen automatisk&lt;br&gt;AI-retting" style="whiteSpace=wrap;html=1;fontSize=18;spacing=12;ellipse;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=22;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="365" width="300" height="250" />
        </mxCell>
        <mxCell id="order" value="&lt;b&gt;1. Du bestiller&lt;/b&gt;&lt;br&gt;Første bygging eller&lt;br&gt;en målrettet forbedring" style="whiteSpace=wrap;html=1;fontSize=18;spacing=12;rounded=1;arcSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="475" y="145" width="250" height="120" />
        </mxCell>
        <mxCell id="build" value="&lt;b&gt;2. AI bygger / retter&lt;/b&gt;&lt;br&gt;Ut fra modellene&lt;br&gt;og bestillingen din" style="whiteSpace=wrap;html=1;fontSize=18;spacing=12;rounded=1;arcSize=25;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="810" y="300" width="270" height="120" />
        </mxCell>
        <mxCell id="run" value="&lt;b&gt;3. Du starter kontroll&lt;/b&gt;&lt;br&gt;Lagre kodeversjonen.&lt;br&gt;Kjør kontrollene på server." style="whiteSpace=wrap;html=1;fontSize=18;spacing=12;rounded=1;arcSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="810" y="570" width="270" height="120" />
        </mxCell>
        <mxCell id="check" value="&lt;b&gt;4. Verktøyene måler&lt;/b&gt;&lt;br&gt;Tester, modellkontroll&lt;br&gt;og benchmark" style="whiteSpace=wrap;html=1;fontSize=18;spacing=12;rounded=1;arcSize=25;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="475" y="735" width="250" height="120" />
        </mxCell>
        <mxCell id="report" value="&lt;b&gt;5. Du får rapport&lt;/b&gt;&lt;br&gt;Feil, modellavvik, svartider&lt;br&gt;og FoM-kurver" style="whiteSpace=wrap;html=1;fontSize=18;spacing=12;rounded=1;arcSize=25;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="120" y="570" width="270" height="120" />
        </mxCell>
        <mxCell id="decision" value="&lt;b&gt;6. Du vurderer&lt;/b&gt;&lt;br&gt;Hva må forbedres?&lt;br&gt;Ny bestilling eller stopp." style="whiteSpace=wrap;html=1;fontSize=18;spacing=12;rounded=1;arcSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="120" y="300" width="270" height="120" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=12;strokeWidth=3;strokeColor=#64748b;fontSize=15;defaultLabelBackgroundColor=page;" edge="1" source="order" target="build" parent="1">
          <mxGeometry as="geometry" relative="1" />
