        <mxCell id="e2" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=12;strokeWidth=3;strokeColor=#64748b;fontSize=15;defaultLabelBackgroundColor=page;" edge="1" source="build" target="run" parent="1">
          <mxGeometry as="geometry" relative="1" />
